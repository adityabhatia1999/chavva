peline{
    agent any
    tools {
        maven 'maven'
    }
    stages{
        stage('Clone'){
            steps{
                git branch: 'main', credentialsId: 'jenkins-nexus-git', url: 'https://github.com:adityabhatia1999/jenkins-nexus-repo.git'

            }
            
        }
        stage('Build'){
            steps{
                dir('apps'){
                script{
                sh 'pwd'
                sh 'ls'
                sh 'mvn --version'
                sh 'mvn compile' 
                }
                }     
            }
            
            
        }   
        stage('Test'){
            steps{
                dir('apps'){
                script{
                sh 'mvn test' 
                }
                }     
            }
            
            
        } 
        stage('Package'){
            steps{
                dir('apps'){
                script{
                sh 'mvn package' 
                }
                }     
            }
            
            
        }                        
    }
}


===========



pipeline {
    agent any

    tools {
        maven 'maven' // Ensure 'maven' is properly configured in Jenkins
    }

    stages {
        stage('Clone') {
            steps {
                git branch: 'main', credentialsId: 'my-jenkins-pat', url: 'https://github.com/adityabhatia1999/new-jenkins.git'
            }
        }

        stage('Build') {
            steps {
                script {
                    dir('apps') {
                        sh 'pwd'
                        sh 'ls -lah'
                        sh 'mvn --version'
                        sh 'mvn compile'
                    }
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    dir('apps') {
                        sh 'mvn test'
                    }
                }
            }
        }

        stage('Package') {
            steps {
                script {
                    dir('apps') {
                        sh 'mvn package'
                    }
                }
            }
        }
    }
}
