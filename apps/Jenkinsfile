peline{
    agent any
    tools {
        maven 'maven'
    }
    stages{
        stage('Clone'){
            steps{
                git branch: 'main', credentialsId: 'jenkins-pat', url: 'https://github.com/adityabhatia1999/chavva.git'

            }
            
        }
        stage('Build'){
            steps{
                dir('apps'){
                script{
                sh 'pwd'
                sh 'ls'
                sh 'mvn --version'
                sh 'mvn compile' 
                }
                }     
            }
            
            
        }   
        stage('Test'){
            steps{
                dir('apps'){
                script{
                sh 'mvn test' 
                }
                }     
            }
            
            
        } 
        stage('Package'){
            steps{
                dir('apps'){
                script{
                sh 'mvn package' 
                }
                }     
            }
            
            
        }                        
    }
}h
